{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.Seq"
        ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "Seq",
                "Args": { "serverUrl": "http://localhost:5341" }
            }
        ],
        "Enrich": [ "FromLogContext" ]
    },
    "ConnectionStrings": {
        "DATABASE": "Host=localhost;Port=5432;Database=url_shortener;Username=postgres;Password=postgres",
        "REDIS": "localhost:6379"
    },
    "Jwt": {
        "Issuer": "Shortener",
        "Audience": "Shortener",
        "SecretKey": "a-string-secret-at-least-256-bits-long",
        "ExpirationInMinutes": "1440"
    }
}
